{
  "name": "sanctuary",
  "productName": "Sanctuary",
  "version": "0.1.0",
  "description": "Offline lyrics & Bible verse presentation for Nepali churches",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "publish": "electron-builder --win --publish always"
  },
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "org.sanctuary.app",
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    },
    "mac": {
      "target": "dmg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "Hemant-Gurung",
      "repo": "Bhajan-Sangraha"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
