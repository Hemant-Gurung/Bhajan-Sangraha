{
  "name": "sanctuary",
  "productName": "Bachan & Bhajan",
  "version": "0.1.6",
  "description": "Offline lyrics & Bible verse presentation for Nepali churches",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "start:web": "python3 -m http.server 8412 --directory . & open http://127.0.0.1:8412/src/renderer/operator.html",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "publish": "env $(grep -v '^#' .env | xargs) electron-builder --win --publish always"
  },
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "org.sanctuary.app",
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    },
    "mac": {
      "target": {
        "target": "dmg",
        "arch": [
          "arm64"
        ]
      },
      "artifactName": "Bachan-Bhajan-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Bachan-Bhajan-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Hemant-Gurung",
      "repo": "Bhajan-Sangraha",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
